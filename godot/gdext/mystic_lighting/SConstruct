#!/usr/bin/env python
import os
import sys

# SConstruct untuk Mystic Lighting GDExtension (port lighting.py -> godot++)
# Cara pakai:
#   cd godot/gdext/mystic_lighting
#   git clone -b godot-4.3-stable https://github.com/godotengine/godot-cpp godot-cpp --depth 1
#   scons target=template_release -j4
#   scons target=template_debug -j4
#   scons platform=android target=template_release android_arch=arm64v8 -j4

# Cek godot-cpp ada
if not os.path.isdir("godot-cpp"):
    print("\n[ERROR] godot-cpp tidak ditemukan!")
    print("Jalankan:")
    print("  git clone -b godot-4.3-stable https://github.com/godotengine/godot-cpp godot-cpp --depth 1")
    print("Atau untuk Godot 4.4:")
    print("  git clone -b 4.3 https://github.com/godotengine/godot-cpp godot-cpp --depth 1")
    print("")
    sys.exit(1)

env = SConscript("godot-cpp/SConstruct")

# Tambah include path src/
env.Append(CPPPATH=["src/"])

# Kumpulkan source
sources = Glob("src/*.cpp")

# Tentukan output path ke addons/mystic_lighting/bin/
# Format nama mengikuti konvensi godot-cpp
if env["platform"] == "macos":
    # macos framework
    library = env.SharedLibrary(
        "../../addons/mystic_lighting/bin/libmystic_lighting.{}.{}.framework/libmystic_lighting.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    # linux/windows/android/ios
    # suffix sudah mengandung platform+target+arch, contoh .linux.debug.x86_64
    library = env.SharedLibrary(
        "../../addons/mystic_lighting/bin/libmystic_lighting{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)

# Info
print("\n[Mystic Lighting] Building for platform={} target={} arch={}".format(env["platform"], env["target"], env.get("arch", "default")))
print("[Mystic Lighting] Output -> godot/addons/mystic_lighting/bin/")
print("[Mystic Lighting] Setelah build, aktifkan di project.godot:")
print("  mystic/rendering/use_gdext_lighting=true")
print("")

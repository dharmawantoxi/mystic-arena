#!/usr/bin/env python
import os
import sys

# SConstruct untuk Mystic UI GDExtension (port ui_components/_bundle.py ->
# godot++: LAYOUT + STATE + LABEL dari 11 submodul komponen UI).
# Cara pakai:
#   cd godot/gdext/mystic_ui
#   git clone -b godot-4.3-stable https://github.com/godotengine/godot-cpp godot-cpp --depth 1
#   scons platform=linux target=template_debug -j4
#   scons platform=linux target=template_release -j4
#   scons platform=android target=template_release android_arch=arm64v8 -j4
#
# godot-cpp BOLEH dipakai bersama dengan ekstensi lain (mystic_skills,
# mystic_levels, mystic_lighting, mystic_maps) lewat symlink — objek build
# godot-cpp ada DI DALAM direktori godot-cpp, jadi ekstensi yang menunjuk
# checkout yang sama memakai ulang hasil compile yang sama:
#   git clone -b godot-4.3-stable --depth 1 \
#     https://github.com/godotengine/godot-cpp godot/gdext/godot-cpp
#   ln -s ../godot-cpp godot/gdext/mystic_ui/godot-cpp
# Itulah yang dilakukan CI (.github/workflows/godot-gdext.yml): satu clone +
# satu cache untuk lib yang dibuild.

if not os.path.isdir("godot-cpp"):
    print("\n[ERROR] godot-cpp tidak ditemukan!")
    print("Jalankan:")
    print("  git clone -b godot-4.3-stable https://github.com/godotengine/godot-cpp godot-cpp --depth 1")
    print("Atau pakai checkout bersama (hemat compile kalau sudah build ekstensi lain):")
    print("  ln -s ../godot-cpp godot-cpp")
    print("")
    sys.exit(1)

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])

sources = Glob("src/*.cpp")

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "../../addons/mystic_ui/bin/libmystic_ui.{}.{}.framework/libmystic_ui.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    # suffix sudah mengandung platform+target+arch, contoh
    # ".linux.template_debug.x86_64" — nama berkas inilah yang harus ditulis
    # di [libraries] addons/mystic_ui/mystic_ui.gdextension (kunci Godot-nya
    # linux.debug.x86_64, NILAI-nya nama berkas scons).
    library = env.SharedLibrary(
        "../../addons/mystic_ui/bin/libmystic_ui{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)

print("\n[Mystic UI] Building for platform={} target={} arch={}".format(env["platform"], env["target"], env.get("arch", "default")))
print("[Mystic UI] Output -> godot/addons/mystic_ui/bin/")
print("[Mystic UI] Setelah build, aktifkan di project.godot:")
print("  mystic/ui/use_gdext_ui=true")
print("")

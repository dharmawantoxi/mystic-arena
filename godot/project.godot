; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

name="Mystic Arena"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "Mobile")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.0431373, 0.0392157, 0.0705882, 1)

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
HeroDB="*res://scripts/core/HeroDB.gd"
BossDB="*res://scripts/core/BossDB.gd"
TowerDB="*res://scripts/core/TowerDB.gd"
ItemDB="*res://scripts/core/ItemDB.gd"
CombatSystem="*res://scripts/systems/CombatSystem.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
MobileLayout="*res://scripts/autoload/MobileLayout.gd"
AppShell="*res://scripts/autoload/AppShell.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1


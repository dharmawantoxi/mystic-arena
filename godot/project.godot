[input_devices]

pointing/emulate_touch_from_mouse=true
; Kontrak TouchHUD (FASE 23): sentuhan perangkat TIBA sebagai mouse, jadi
; TouchHUD._input hanya menangani InputEventMouseButton (menangani touch
; juga = aksi ganda). Default engine memang true; ditulis eksplisit supaya
; tak ada yang mematikan tanpa sadar lalu tombol sentuh mati di HP.
pointing/emulate_mouse_from_touch=true

[rendering]

; Desktop (F5, CI headless) tetap Forward+. Forward+ TIDAK didukung Android,
; jadi Android/iOS dipaksa renderer Mobile via override platform di bawah —
; Mobile mendukung semua fitur 2D yang dipakai project (CanvasModulate/Light2D,
; glow, shader canvas_item, 2D HDR); memakai Vulkan bila ada, otomatis jatuh
; ke OpenGL ES 3.0 kalau tidak (fallback_to_opengl3 default true), minSdk 24.
; Lihat docs/PLAYSTORE_RELEASE.md (Fase 6).
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.0431373, 0.0392157, 0.0705882, 1)
textures/canvas_textures/default_texture_filter=2
textures/canvas_textures/default_texture_repeat=0
renderer/viewport/hdr_2d=true

[rendering/environment]

glow/enabled=true
glow/strength=0.8
glow/bloom=0.15
glow/hdr_threshold=0.9

[physics]

; 1 langkah = 1/60 detik (paritas FIXED_DT_MS main.py:335).
common/physics_ticks_per_second=60
; Pembatas kejaran = MAX_CATCHUP main.py:336 (4, bukan bawaan engine 8):
; 8 langkah memakan seluruh anggaran frame berikutnya di HP ("spiral
; kematian"), 4 langkah masih mengejar penuh sampai 15 FPS.
common/max_physics_steps_per_frame=4

[mystic]

; Keep the normal arena faithful to Pygame; KaizenDemo still uses the rig.
rendering/experimental_hero_rigs=false

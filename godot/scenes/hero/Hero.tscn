[sub_resource type="Shader" id="Shader_outline"]
code = "shader_type canvas_item;\nuniform vec4 outline_color : source_color = vec4(1.0, 0.9, 0.4, 1.0);\nuniform float outline_width : hint_range(0.0, 4.0) = 1.5;\nuniform float flash_amount : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n    vec4 c = texture(TEXTURE, UV);\n    // outline: sample 4 neighbours\n    float a = c.a;\n    float outline = 0.0;\n    outline += texture(TEXTURE, UV + vec2(outline_width*TEXTURE_PIXEL_SIZE.x, 0.0)).a;\n    outline += texture(TEXTURE, UV + vec2(-outline_width*TEXTURE_PIXEL_SIZE.x, 0.0)).a;\n    outline += texture(TEXTURE, UV + vec2(0.0, outline_width*TEXTURE_PIXEL_SIZE.y)).a;\n    outline += texture(TEXTURE, UV + vec2(0.0, -outline_width*TEXTURE_PIXEL_SIZE.y)).a;\n    outline = clamp(outline - a, 0.0, 1.0);\n    vec4 col = mix(c, outline_color, outline * (1.0 - a));\n    // hit flash\n    col.rgb = mix(col.rgb, vec3(1.0), flash_amount * a);\n    COLOR = col;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_outline"]
shader = SubResource("Shader_outline")
shader_parameter/outline_color = Color(1, 0.9, 0.4, 1)
shader_parameter/outline_width = 1.5
shader_parameter/flash_amount = 0.0


; Aura CPUParticles2D (bukan GPU): GPUParticles butuh compute/shader partikel
; yang di renderer Compatibility Android/GLES di-fallback, sama alasannya
; dengan partikel cuaca ArenaMap.gd. Untuk 24 partikel CPU lebih murah
; daripada satu draw pass shader. Parameter emisi = properti node langsung
; (Vector2 + scale_amount_*), BUKAN ParticleProcessMaterial.
[node name="Aura" type="CPUParticles2D" parent="FX"]
emitting = true
amount = 24
lifetime = 1.2
lifetime_randomness = 0.35
emission_shape = 1
emission_sphere_radius = 26.0
direction = Vector2(0, -1)
spread = 55.0
initial_velocity_min = 12.0
initial_velocity_max = 34.0
gravity = Vector2(0, -8)
scale_amount_min = 0.35
scale_amount_max = 1.0

; HP bar + papan nama boss (base_boss.py:6225-6276). SESUDAH Visual supaya

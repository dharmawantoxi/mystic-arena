; GDExtension mystic_mobile — port mobile/ (8 submodul) ke godot++ (C++).
;
; NAMA BERKAS PENTING: kunci di [libraries] memakai nama TARGET GODOT
; (debug/release/editor), sedangkan NILAI-nya harus nama berkas hasil scons
; yang memakai nama TARGET BUILD godot-cpp (template_debug/template_release).
; Kedua nama itu BEDA — `libmystic_mobile.linux.debug.x86_64.so` tidak pernah
; dihasilkan SConstruct, jadi Godot akan selalu gagal memuat lib dan diam-diam
; jatuh ke fallback GDScript. Konvensi resmi godot-cpp:
;   linux.debug.x86_64 = ".../libgdexample.linux.template_debug.x86_64.so"
; (godot-cpp/test/project/example.gdextension).
;
; Arch Android juga mengikuti godot-cpp: `arm64` / `arm32` / `x86_64`
; (bukan `arm64v8` / `armeabi-v7a` yang merupakan nama android_arch scons).
;
; FASE 37: lib ini BELUM punya saklar backend di jalur produksi (pola FASE 36
; untuk mystic_ui) — class MysticMobile terdaftar, diuji self-test tanpa
; engine + build CI, dan menunggu pemakaian pertama di jalur GDScript.
;
; Build:
;   cd godot/gdext/mystic_mobile
;   git clone -b godot-4.3-stable --depth 1 \
;     https://github.com/godotengine/godot-cpp godot-cpp
;   scons platform=linux target=template_debug -j4
; (CI memakai SATU checkout godot-cpp bersama untuk lib yang dibuild —
;  mystic_skills + mystic_levels + mystic_maps + mystic_ui + mystic_mobile —
;  lewat symlink `godot-cpp -> ../godot-cpp`; lihat SConstruct.)
; CI: .github/workflows/godot-gdext.yml

[configuration]

entry_symbol = "mystic_mobile_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_release.x86_64.so"
linux.debug.x86_32 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_debug.x86_32.so"
linux.release.x86_32 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_release.x86_32.so"
linux.debug.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_release.arm64.so"
linux.debug.arm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_debug.arm32.so"
linux.release.arm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.linux.template_release.arm32.so"
windows.debug.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_release.x86_32.dll"
windows.debug.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.windows.template_release.arm64.dll"
macos.debug = "res://addons/mystic_mobile/bin/libmystic_mobile.macos.template_debug.framework"
macos.release = "res://addons/mystic_mobile/bin/libmystic_mobile.macos.template_release.framework"
android.debug.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_release.arm64.so"
android.debug.arm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_debug.arm32.so"
android.release.arm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_release.arm32.so"
android.debug.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/mystic_mobile/bin/libmystic_mobile.android.template_release.x86_64.so"
web.debug.wasm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://addons/mystic_mobile/bin/libmystic_mobile.web.template_release.wasm32.wasm"

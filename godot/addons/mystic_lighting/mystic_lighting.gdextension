[configuration]
entry_symbol = "mystic_lighting_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/mystic_lighting/bin/libmystic_lighting.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/mystic_lighting/bin/libmystic_lighting.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://addons/mystic_lighting/bin/libmystic_lighting.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mystic_lighting/bin/libmystic_lighting.windows.template_release.x86_64.dll"
macos.debug = "res://addons/mystic_lighting/bin/libmystic_lighting.macos.template_debug.framework"
macos.release = "res://addons/mystic_lighting/bin/libmystic_lighting.macos.template_release.framework"
macos.debug.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.macos.template_debug.framework"
macos.release.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.macos.template_release.framework"
android.debug.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/mystic_lighting/bin/libmystic_lighting.android.template_release.arm64.so"
android.debug.arm32 = "res://addons/mystic_lighting/bin/libmystic_lighting.android.template_debug.arm32.so"
android.release.arm32 = "res://addons/mystic_lighting/bin/libmystic_lighting.android.template_release.arm32.so"

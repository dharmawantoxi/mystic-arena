; GDExtension mystic_levels — port levels/level_data.py ke godot++ (C++).
;
; NAMA BERKAS PENTING: kunci di [libraries] memakai nama TARGET GODOT
; (debug/release/editor), sedangkan NILAI-nya harus nama berkas hasil scons
; yang memakai nama TARGET BUILD godot-cpp (template_debug/template_release).
; Kedua nama itu BEDA — `libmystic_levels.linux.debug.x86_64.so` tidak pernah
; dihasilkan SConstruct, jadi Godot akan selalu gagal memuat lib dan diam-diam
; jatuh ke fallback GDScript. Konvensi resmi godot-cpp:
;   linux.debug.x86_64 = ".../libgdexample.linux.template_debug.x86_64.so"
; (godot-cpp/test/project/example.gdextension).
;
; Arch Android juga mengikuti godot-cpp: `arm64` / `arm32` / `x86_64`
; (bukan `arm64v8` / `armeabi-v7a` yang merupakan nama android_arch scons).
;
; Build:
;   cd godot/gdext/mystic_levels
;   git clone -b godot-4.3-stable --depth 1 \
;     https://github.com/godotengine/godot-cpp godot-cpp
;   scons platform=linux target=template_debug -j4
; (CI memakai SATU checkout godot-cpp bersama untuk kedua ekstensi yang
;  dibuild — mystic_skills + mystic_levels — lewat symlink
;  `godot-cpp -> ../godot-cpp`; lihat SConstruct. mystic_lighting ikut pola
;  yang sama kalau nanti ikut dibuild.)
; CI: .github/workflows/godot-gdext.yml

[configuration]

entry_symbol = "mystic_levels_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_release.x86_64.so"
linux.debug.x86_32 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_debug.x86_32.so"
linux.release.x86_32 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_release.x86_32.so"
linux.debug.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_release.arm64.so"
linux.debug.arm32 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_debug.arm32.so"
linux.release.arm32 = "res://addons/mystic_levels/bin/libmystic_levels.linux.template_release.arm32.so"
windows.debug.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_release.x86_32.dll"
windows.debug.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.windows.template_release.arm64.dll"
macos.debug = "res://addons/mystic_levels/bin/libmystic_levels.macos.template_debug.framework"
macos.release = "res://addons/mystic_levels/bin/libmystic_levels.macos.template_release.framework"
android.debug.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_release.arm64.so"
android.debug.arm32 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_debug.arm32.so"
android.release.arm32 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_release.arm32.so"
android.debug.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/mystic_levels/bin/libmystic_levels.android.template_release.x86_64.so"
web.debug.wasm32 = "res://addons/mystic_levels/bin/libmystic_levels.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://addons/mystic_levels/bin/libmystic_levels.web.template_release.wasm32.wasm"

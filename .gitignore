# Checkout godot-cpp BERSAMA (satu clone untuk semua ekstensi; tiap ekstensi
# men-symlink `godot-cpp -> ../godot-cpp` sehingga objek build-nya dipakai
# ulang). CI .github/workflows/godot-gdext.yml memakai tata letak ini.
godot/gdext/godot-cpp/
godot/gdext/godot-cpp


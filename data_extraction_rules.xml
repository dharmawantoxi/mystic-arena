<?xml version="1.0" encoding="utf-8"?>
<!--
  Aturan backup untuk Android 12+ (API 31+), dirujuk dari
  AndroidManifest lewat android:dataExtractionRules (disisipkan via
  `android.extra_manifest_application_arguments` di buildozer.spec;
  file ini masuk ke res/xml lewat `android.res_xml`).

  cloud-backup    : backup otomatis ke Google Drive
  device-transfer : transfer langsung saat setup HP baru (kabel/WiFi)

  Hanya folder saves/ (di dalam getFilesDir) yang disertakan -
  lihat penjelasan di backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
    </device-transfer>
</data-extraction-rules>

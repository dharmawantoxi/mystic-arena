[gd_scene load_steps=5 format=3 uid="uid://b8windwall"]

[ext_resource type="Script" path="res://scripts/fx/wind_wall.gd" id="1_windwall"]

[sub_resource type="RectangleShape2D" id="Rect_windwall"]
size = Vector2(220, 110)

[sub_resource type="Shader" id="Shader_windwall"]
code = "shader_type canvas_item;
render_mode blend_add, unshaded;

uniform float time_scale : hint_range(0.1, 5.0) = 1.5;
uniform vec4 core_color : source_color = vec4(0.847, 0.949, 1.0, 0.85);
uniform vec4 edge_color : source_color = vec4(0.439, 0.698, 0.902, 0.55);

void fragment() {
    vec2 uv = UV;
    float t = TIME * time_scale;
    // Distance from the centre band — the wall is tallest at the centre.
    float band = 1.0 - smoothstep(0.0, 0.5, abs(uv.y - 0.5));
    // Wavy edges.
    float wave = sin(uv.x * 18.0 - t * 4.0) * 0.04 + sin(uv.x * 7.0 + t * 2.0) * 0.06;
    float dist = abs(uv.x - 0.5 + wave);
    float horiz = 1.0 - smoothstep(0.30, 0.50, dist);
    // Vertical streaks to suggest wind flow.
    float streak = sin(uv.x * 60.0 + t * 6.0) * 0.5 + 0.5;
    streak = pow(streak, 3.0);
    vec4 col = mix(edge_color, core_color, horiz);
    col.a *= (band * 0.5 + 0.5) * (0.6 + 0.4 * streak);
    // Fade out at the left and right edges for a softer silhouette.
    float edge_fade = smoothstep(0.0, 0.1, uv.x) * smoothstep(1.0, 0.9, uv.x);
    col.a *= edge_fade;
    COLOR = col;
}"


; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mystic Arena — Kaizen Slice"
config/description="Godot 4.x vertical slice of Mystic Arena's Kaizen character (wind-blade assassin)."
config/features=PackedStringArray("4.3", "Forward Plus")
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.svg"

[autoload]

GameFeel="*res://scripts/autoload/game_feel.gd"
VFXManager="*res://scripts/autoload/vfx_manager.gd"
ParticlePool="*res://scripts/autoload/particle_pool.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


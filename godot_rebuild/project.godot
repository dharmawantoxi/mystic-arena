; Fresh native project. Does not import the previous Godot migration.
config_version=5

[application]
config/name="Mystic Arena Rebuild"
run/main_scene="res://app/App.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Migrasi baru — wave, gold, build/sell dan upgrade Archer; belum game penuh."
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="MysticArenaRebuildDev"
config/cloud_save_enabled=true

[autoload]

AudioManager="*res://scripts/audio/audio_manager.gd"
GameSpeed="*res://scripts/simulation/game_speed_runtime.gd"
FrameRateLimit="*res://scripts/settings/frame_rate_limit_runtime.gd"
AdaptiveQuality="*res://scripts/settings/adaptive_quality_runtime.gd"
Localization="*res://scripts/settings/localization_runtime.gd"
CloudSave="*res://scripts/match/cloud_save_runtime.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/mystic_cloud/plugin.cfg")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
; Run-window override only (F5 in the editor / desktop play). 1624x720 is the
; logical surface of the 2436x1080 Android build, so the 344 px right dock is
; visible while checking parity on a touch screen PC. The design base stays
; 1280x720: canvas = window / min(window.x / 1280, window.y / 720).
window/size/window_width_override=1624
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=false

[input]
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
select={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
command_move={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

[audio]
; main.py calls pygame.mixer.pre_init(44100, -16, 2, 1024) before init, so the
; whole source mix runs at 44.1 kHz. Godot's driver default is the same value;
; pinning it keeps the contract visible (layer 9cn, D4 documents the buffer).
driver/mix_rate=44100

[physics]
common/physics_ticks_per_second=60
; main.py caps catch-up at MAX_CATCHUP = 4 simulation steps per frame so a slow
; frame can never start a "spiral of death". Godot's default is 8; 4 is the
; source value (layer 9cn).
common/max_physics_steps_per_frame=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0353, 0.0471, 0.102, 1)
textures/default_filters/use_nearest_mipmap_filter=false

extends RefCounted
## 9l: the hero armour model of `Hero.take_damage` (`_entity.py:4638-4672`).
## The Soul Rend amp runs first, then the armour formula applies to every
## non-fire hit **regardless of school** - the source never reads
## `magic_resist` for heroes, and all 222 hero definitions carry `armor = 0`, so
## the only armour a hero ever has is the item armour minus armor shred.
##
## The rebuild (layer 5b-3) resolved mitigation from the school instead:
## physical -> item armour, magic -> `definition.magic_resist` (0 for every
## hero, so magic hits landed raw), with the amp applied afterwards. This suite
## replays the sealed `hero_armor_model_source.json` fixture (generated by
## `hero_armor_model_source_oracle.py`, which executes the real method) through
## the production `_deliver_hit`, and pins the non-hero path so minion magic
## resistance keeps working exactly as before.

const World = preload("res://scripts/match/prototype_battle.gd")
const DamageRules = preload("res://scripts/combat/damage_rules.gd")
const HeroState = preload("res://scripts/combat/hero_state.gd")
const UnitState = preload("res://scripts/combat/unit_state.gd")
const FIXTURE := "res://tests/fixtures/hero_armor_model_source.json"
const ARMOR_ITEM := "steel_aegis"
const UNDEAD = preload("res://data/minions/undead.tres")
const SOURCE_SCHOOLS := ["physical", "magic", "neutral"]
# Undead carry `magic_resist = 0.15`; the non-hero path must keep cutting with it.
const UNDEAD_MAGIC_RESIST := 0.15
const MINION_MAGIC_HIT := 170
const MINION_NEUTRAL_HIT := 200


class RollSpy:
	extends RefCounted
	var calls := 0

	func roll() -> float:
		calls += 1
		return 0.99


func run(check: Callable) -> void:
	check.call(FileAccess.file_exists(FIXTURE), "the hero armour fixture is committed")
	if not FileAccess.file_exists(FIXTURE):
		return
	var fixture: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	check.call(fixture is Dictionary, "the hero armour fixture parses")
	if fixture is not Dictionary:
		return
	_item_contract(fixture, check)
	_replay(fixture.cases, check)
	_non_hero_path(check)


func _item_contract(fixture: Dictionary, check: Callable) -> void:
	var world := _world()
	var hero: HeroState = world.blue_hero()
	var item: Dictionary = fixture.get("item", {})
	check.call(hero.items.add(ARMOR_ITEM), "the fixture armour item is addable")
	check.call(
		is_equal_approx(hero.items.get_armor(), float(item.get("armor", -1))),
		"the fixture armour value is the live catalog value"
	)
	check.call(
		hero.items.get_block() == null,
		"the fixture armour item carries no block entry, so the 9k roll stays out"
	)


func _replay(rows: Array, check: Callable) -> void:
	var replayed := 0
	for row in rows:
		var data: Dictionary = row as Dictionary
		var expected: Dictionary = data.get("expected", {})
		var school: Variant = expected.get("school")
		if school != null and String(school) not in SOURCE_SCHOOLS:
			continue
		if int(data.get("damage", 0)) <= 0:
			continue
		replayed += 1
		var world := _world()
		var defender: HeroState = world.blue_hero()
		var attacker: HeroState = _hero_of_team(world, World.RED)
		if int(data.get("armor", 0)) > 0:
			defender.items.add(ARMOR_ITEM)
		defender.armor_shred_amount = float(data.get("armor_shred", 0.0))
		defender.dmg_amp_timer = int(data.get("dmg_amp_timer", 0))
		defender.dmg_amp_amount = float(data.get("dmg_amp_amount", 0.0))
		var spy := RollSpy.new()
		world.block_roll_override = Callable(spy, "roll")
		var hp_before: float = defender.hp
		# The source resolver returns None for school-free hits; the native entry
		# point carries "neutral" for those.
		var entry_school := String(school) if school != null else "neutral"
		var landed: bool = world._deliver_hit(
			attacker.id,
			attacker.team,
			defender,
			int(data["damage"]),
			entry_school,
			attacker.position,
			String(data.get("damage_type", "normal"))
		)
		var loss := int(hp_before - defender.hp)
		var label := String(data["name"])
		check.call(
			loss == int(expected["hp_loss"]),
			"%s: the source armour ladder deals %d" % [label, int(expected["hp_loss"])]
		)
		check.call(
			landed == (int(expected["hp_loss"]) > 0),
			"%s: landed flag follows the source ladder" % label
		)
		check.call(
			attacker.damage_dealt == int(expected["hp_loss"]),
			"%s: the credited damage follows the armour model" % label
		)
		check.call(
			spy.calls == 0, "%s: an armour row without a block item consumes no block roll" % label
		)
		if int(data["native_old"]["hp_loss"]) != int(expected["hp_loss"]):
			check.call(
				loss != int(data["native_old"]["hp_loss"]),
				"%s: the armour column no longer equals the pre-9l column" % label
			)
	check.call(replayed >= 8, "at least eight fixture rows replay through the production path")


func _non_hero_path(check: Callable) -> void:
	# Layer 9l only moves the HERO ladder. Minions keep the school model: undead
	# magic resist still cuts magic hits and the neutral school still lands raw.
	var world := _world()
	var undead = world.spawn_unit(UNDEAD, World.RED, 1)
	check.call(undead != null, "the undead control unit spawns")
	if undead == null:
		return
	check.call(
		is_equal_approx(float(undead.definition.magic_resist), UNDEAD_MAGIC_RESIST),
		"the control unit carries the expected magic resist"
	)
	check.call(
		DamageRules.item_aware_amount(undead, 200, "magic") == MINION_MAGIC_HIT,
		"a non-hero magic hit still uses magic resist"
	)
	check.call(
		DamageRules.item_aware_amount(undead, 200, "neutral") == MINION_NEUTRAL_HIT,
		"a non-hero neutral hit still bypasses mitigation"
	)
	# The hero helpers stay reachable and school-free on their own.
	var hero: HeroState = world.blue_hero()
	check.call(hero.items.add(ARMOR_ITEM), "the hero control can hold the armour item")
	check.call(DamageRules.hero_amount(hero, 200, "fire") == 200, "fire damage skips hero armour")
	check.call(
		DamageRules.hero_amount(hero, 200, "normal") == 147,
		"a non-fire hero hit is cut by item armour"
	)
	check.call(
		DamageRules.hero_amount(hero, 0, "normal") == 0, "zero damage stays zero on the hero ladder"
	)


func _world() -> World:
	var world := World.new()
	world.setup_arena()
	return world


func _hero_of_team(world: World, team: int) -> HeroState:
	for unit in world.units:
		var hero := unit as HeroState
		if hero != null and hero.is_hero and hero.team == team and hero.alive:
			return hero
	return null

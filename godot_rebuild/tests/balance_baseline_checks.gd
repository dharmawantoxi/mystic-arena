extends RefCounted
## Layer 9b native suite: the ingame hero balance baseline is pinned.
## The fixture is generated by `balance_baseline_source_oracle.py`, which runs
## the project's own audit tool (`tools/balance_audit.py --ingame`) headlessly.
## Any future native rebalance must move these numbers intentionally and
## regenerate the fixture through the oracle - never by hand.

const FIXTURE := "res://tests/fixtures/balance_baseline_ingame.json"


func run(check: Callable) -> void:
	var fixture = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	check.call(fixture is Dictionary and fixture.has("audit"), "balance baseline parses")
	if not fixture is Dictionary:
		return
	check.call(
		String(fixture.get("source", "")).contains("tools/balance_audit.py --ingame"),
		"the baseline comes from the project's own ingame audit tool"
	)
	_switches_check(check, fixture)
	var audit: Dictionary = fixture.get("audit", {})
	_targets_check(check, audit)
	_snapshot_check(check, audit)
	_grid_check(check, audit)


func _switches_check(check: Callable, fixture: Dictionary) -> void:
	var switches: Dictionary = fixture.get("switches", {})
	check.call(
		(
			bool(switches.get("ENABLE_REBUDGET", false))
			and not bool(switches.get("ENABLE_SCHOOL_MOD", true))
			and bool(switches.get("ENABLE_STARTER_CATCHUP", false))
		),
		"the hero_balance switches stay REBUDGET on, SCHOOL_MOD off, CATCHUP on"
	)


func _targets_check(check: Callable, audit: Dictionary) -> void:
	check.call(
		Array(audit.get("violations", ["x"])).is_empty(), "the audit reports zero violations"
	)
	check.call(int(audit.get("n_hero", 0)) == 222, "the roster baseline covers all 222 heroes")
	check.call(
		int(audit.get("n_boss_hero", 0)) == 216, "the balance pass covers the 216 boss heroes"
	)
	check.call(
		float(audit.get("corr_hp_dps", 1.0)) <= 0.80,
		"corr(HP,DPS) stays under the 0.80 trade-off target"
	)
	check.call(
		float(audit.get("identity_spread_x", 0.0)) >= 1.20,
		"the identity spread stays above the 1.20x target"
	)
	check.call(
		float(audit.get("boss_pref_ratio", 0.0)) >= 1.20,
		"boss preference spread stays above the 1.20 target"
	)
	check.call(
		float(audit.get("price_spread_x", 99.0)) <= 2.20,
		"the in-band price spread stays under the 2.20x target"
	)
	var delta: Dictionary = audit.get("pool_power_delta", {})
	check.call(
		(
			absf(float(delta.get("dps_x", 0.0)) - 1.0) <= 0.12
			and absf(float(delta.get("ehp_x", 0.0)) - 1.0) <= 0.12
		),
		"the pool power anchors stay within 0.12: redistribution, not global buff/nerf"
	)
	for mode in ["mini", "true"]:
		var school: Dictionary = Dictionary(audit.get("effective_dps_vs_boss", {})).get(mode, {})
		var ratio := float(school.get("ratio_magic_over_phys", 0.0))
		check.call(
			ratio >= 0.90 and ratio <= 1.15,
			"the %s boss school parity ratio stays inside 0.90..1.15" % mode
		)


func _snapshot_check(check: Callable, audit: Dictionary) -> void:
	check.call(
		is_equal_approx(float(audit.get("corr_hp_dps", 0.0)), 0.535),
		"baseline corr(HP,DPS) is pinned at 0.535"
	)
	check.call(
		is_equal_approx(float(audit.get("identity_spread_x", 0.0)), 1.64),
		"baseline identity spread is pinned at 1.64x"
	)
	check.call(
		is_equal_approx(float(audit.get("boss_pref_ratio", 0.0)), 1.49),
		"baseline boss preference is pinned at 1.49"
	)
	check.call(
		is_equal_approx(float(audit.get("price_spread_x", 0.0)), 1.89),
		"baseline price spread is pinned at 1.89x"
	)
	var starter: Dictionary = audit.get("starter_gap", {})
	check.call(
		is_equal_approx(float(starter.get("gap_x", 0.0)), 5.67),
		"baseline starter gap is pinned at 5.67x"
	)
	var pass_data: Dictionary = audit.get("balance_pass", {})
	check.call(
		int(pass_data.get("applied_to", 0)) == 216, "the balance pass still applies to 216 heroes"
	)
	check.call(
		(
			Array(pass_data.get("hp_mult", [])) == [0.7189, 1.3868]
			and Array(pass_data.get("dmg_mult", [])) == [0.5851, 2.0474]
		),
		"the balance pass multiplier ranges are pinned"
	)
	var curve: Dictionary = audit.get("hero_level_curve", {})
	check.call(
		(
			int(curve.get("max_level", 0)) == 15
			and is_equal_approx(float(curve.get("dmg_mult", 0.0)), 10.0)
			and is_equal_approx(float(curve.get("hp_mult", 0.0)), 12.5)
		),
		"the hero level curve stays 15 levels at 10.0x damage / 12.5x HP"
	)


func _grid_check(check: Callable, audit: Dictionary) -> void:
	var grid: Dictionary = audit.get("identity_grid", {})
	var expected := {
		"MAGIC|CARRY": [11, 0.84],
		"MAGIC|FIGHTER": [82, 0.84],
		"MAGIC|TANK": [25, 1.02],
		"PHYSICAL|CARRY": [10, 1.19],
		"PHYSICAL|FIGHTER": [49, 1.18],
		"PHYSICAL|TANK": [39, 1.38],
	}
	check.call(grid.size() == expected.size(), "the identity grid keeps its six cells")
	for cell in expected:
		var row: Dictionary = grid.get(cell, {})
		var want: Array = expected[cell]
		check.call(
			(
				int(row.get("n", -1)) == int(want[0])
				and is_equal_approx(float(row.get("power", 0.0)), float(want[1]))
			),
			"cell %s keeps n=%d and power %.2f" % [cell, int(want[0]), float(want[1])]
		)

extends RefCounted
## 9k: the hero damage block ladder of `Hero.take_damage` (`_entity.py:4652-4672`).
## Inside the non-fire armour section - i.e. after school mitigation + Soul Rend
## amp and before the Bristleback keep - the source rolls the passive item block
## (`get_block()` -> `(chance, amount)`), lets the Bulwark Guard aura override it
## when larger, and subtracts the winner once:
##
##     block_amt = 0
##     blk = inv.get_block()
##     if blk and random.random() < blk[0]:
##         block_amt = blk[1]
##     if inv.aura_guard_block > block_amt:
##         block_amt = inv.aura_guard_block
##     damage = max(0, damage - block_amt)
##
## Before this layer the rebuild consumed only the aura, and did it *after* the
## Bristleback keep, so `scarlet_bulwark`'s 55% passive block never fired and
## the aura was multiplied by the keep instead of subtracting first. This suite
## replays the sealed `hero_block_source.json` fixture (generated by
## `hero_block_source_oracle.py`, which executes the real method) through the
## production `_deliver_hit`, with a roll spy standing in for the RNG.

const World = preload("res://scripts/match/prototype_battle.gd")
const HeroState = preload("res://scripts/combat/hero_state.gd")
const FIXTURE := "res://tests/fixtures/hero_block_source.json"
const BLOCK_ITEM := "scarlet_bulwark"
const SOURCE_SCHOOLS := ["physical", "magic"]
# Keep-then-block would give 103 - 25; the source blocks first (122) and only
# then multiplies by the Bristleback keep (0.70).
const KEEP_AFTER_BLOCK := 85
const KEEP_BEFORE_BLOCK := 78
const REFLECT_AFTER_BLOCK := 21


class RollSpy:
	extends RefCounted
	var calls := 0
	var value := 0.99

	func roll() -> float:
		calls += 1
		return value


func run(check: Callable) -> void:
	check.call(FileAccess.file_exists(FIXTURE), "the block fixture is committed")
	if not FileAccess.file_exists(FIXTURE):
		return
	var fixture: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	check.call(fixture is Dictionary, "the block fixture parses")
	if fixture is not Dictionary:
		return
	_item_contract(fixture, check)
	_replay(fixture.cases, check)


func _item_contract(fixture: Dictionary, check: Callable) -> void:
	# The fixture numbers must be the live catalog numbers, otherwise the replay
	# would silently test a different item than the source arm reads.
	var world := _world()
	var hero: HeroState = world.blue_hero()
	var item: Dictionary = fixture.get("item", {})
	check.call(hero.items.add(BLOCK_ITEM), "the block item named by the fixture is addable")
	var block: Variant = hero.items.get_block()
	check.call(block != null, "a holder of the block item exposes a block tuple")
	if block != null:
		var row: Array = block as Array
		check.call(
			is_equal_approx(float(row[0]), float(item.get("chance", -1.0))),
			"the passive block chance matches the fixture catalog"
		)
		check.call(
			is_equal_approx(float(row[1]), float(item.get("melee_block", -1.0))),
			"the melee block amount matches the fixture catalog"
		)
	check.call(
		is_equal_approx(hero.items.get_armor(), float(item.get("armor", -1))),
		"the item armour used by the fixture matches the catalog"
	)
	check.call(world.block_roll_override.is_valid(), "the match wires the seeded block roll seam")
	check.call(
		world.block_rng is RandomNumberGenerator,
		"lab worlds keep their own block stream as a fallback"
	)


func _replay(rows: Array, check: Callable) -> void:
	var replayed := 0
	for row in rows:
		var data: Dictionary = row as Dictionary
		var expected: Dictionary = data.get("expected", {})
		var school: Variant = expected.get("school")
		if school == null or String(school) not in SOURCE_SCHOOLS:
			continue
		if int(data.get("damage", 0)) <= 0:
			continue
		replayed += 1
		var world := _world()
		var defender: HeroState = world.blue_hero()
		var attacker: HeroState = _hero_of_team(world, World.RED)
		var block: Variant = data.get("block")
		if block != null:
			defender.items.add(BLOCK_ITEM)
		defender.items.aura_guard_block = int(data.get("guard_block", 0))
		if bool(data.get("bristleback", false)):
			defender.bristleback_timer = 60
		var spy := RollSpy.new()
		var draws: Array = data.get("draws", [])
		if not draws.is_empty():
			spy.value = float(draws[0])
		world.block_roll_override = Callable(spy, "roll")
		var hp_before: float = defender.hp
		var attacker_hp_before: float = attacker.hp
		var landed: bool = world._deliver_hit(
			attacker.id,
			attacker.team,
			defender,
			int(data["damage"]),
			String(school),
			attacker.position,
			String(data.get("damage_type", "normal"))
		)
		var hp_loss := int(hp_before - defender.hp)
		var label := String(data["name"])
		check.call(
			hp_loss == int(expected["hp_loss"]),
			"%s: the source block ladder deals %d" % [label, int(expected["hp_loss"])]
		)
		check.call(
			landed == (int(expected["hp_loss"]) > 0),
			"%s: landed flag follows the source ladder" % label
		)
		check.call(
			attacker.damage_dealt == int(expected["hp_loss"]),
			"%s: the credited damage follows the block" % label
		)
		check.call(
			spy.calls == int(expected["random_draws"]),
			"%s: the passive roll is consumed exactly like the source" % label
		)
		if int(data["native_old"]["hp_loss"]) != int(expected["hp_loss"]):
			check.call(
				hp_loss != int(data["native_old"]["hp_loss"]),
				"%s: the block column no longer equals the pre-9k column" % label
			)
		if bool(data.get("bristleback", false)):
			check.call(
				hp_loss == KEEP_AFTER_BLOCK and hp_loss != KEEP_BEFORE_BLOCK,
				"%s: the block lands before the Bristleback keep" % label
			)
			check.call(
				int(attacker_hp_before - attacker.hp) == REFLECT_AFTER_BLOCK,
				"%s: the reflect uses the post-block, post-keep damage" % label
			)
	check.call(replayed >= 6, "at least six fixture rows replay through the production path")


func _world() -> World:
	var world := World.new()
	world.setup_arena()
	return world


func _hero_of_team(world: World, team: int) -> HeroState:
	for unit in world.units:
		var hero := unit as HeroState
		if hero != null and hero.is_hero and hero.team == team and hero.alive:
			return hero
	return null

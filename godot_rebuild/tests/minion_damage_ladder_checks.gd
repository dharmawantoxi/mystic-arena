extends RefCounted
## 9n: the minion damage ladder of `Minion.take_damage` (`_entity.py:5795-5825`).
## The Soul Rend amp runs first, then the Corroder shred bonus on every
## non-fire hit (`damage * (1 + min(1, shred * 0.06))`), and only then the
## school mitigation: physical subtracts the same shred from the armour a
## second time, magic cuts with `magic_resist`, and a school-free hit skips
## mitigation while keeping both bonuses.
##
## The rebuild (layer 5b-3) resolved the school mitigation first, ran the amp
## after it, returned the raw number for `neutral` and never applied the shred
## bonus. This suite replays the sealed `minion_damage_ladder_source.json`
## fixture (generated by `minion_damage_ladder_source_oracle.py`, which executes
## the real method) through the production `_deliver_hit`, and pins the boss
## branch: bosses keep the school-first order, because `BaseBoss.take_damage`
## is its own port.

const World = preload("res://scripts/match/prototype_battle.gd")
const DamageRules = preload("res://scripts/combat/damage_rules.gd")
const HeroState = preload("res://scripts/combat/hero_state.gd")
const UnitState = preload("res://scripts/combat/unit_state.gd")
const BossState = preload("res://scripts/match/boss_state.gd")
const TROLL = preload("res://data/minions/troll.tres")
const UNDEAD = preload("res://data/minions/undead.tres")
const FIXTURE := "res://tests/fixtures/minion_damage_ladder_source.json"
const SCHOOLS := ["physical", "magic", "neutral"]
# The live stats the fixture rows are built on (troll.tres / undead.tres).
const TROLL_ARMOR := 2.0
const UNDEAD_MAGIC_RESIST := 0.15
# Same unit, both ladders: the boss order gives 233, the minion ladder 232.
const BOSS_ORDER_HIT := 233
const MINION_LADDER_HIT := 232


func run(check: Callable) -> void:
	check.call(FileAccess.file_exists(FIXTURE), "the minion damage fixture is committed")
	if not FileAccess.file_exists(FIXTURE):
		return
	var fixture: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	check.call(fixture is Dictionary, "the minion damage fixture parses")
	if fixture is not Dictionary:
		return
	_live_stats(fixture, check)
	_replay(fixture.cases, check)
	_boss_order(check)


func _live_stats(fixture: Dictionary, check: Callable) -> void:
	var stats: Dictionary = fixture.get("live_stats", {})
	check.call(
		is_equal_approx(float(TROLL.armor), float(stats.get("troll_armor", -1.0))),
		"the troll armour is the fixture value"
	)
	check.call(
		is_equal_approx(float(UNDEAD.magic_resist), float(stats.get("undead_magic_resist", -1.0))),
		"the undead magic resist is the fixture value"
	)
	check.call(UNDEAD.armor == 0.0, "the undead control carries no armour")


func _replay(rows: Array, check: Callable) -> void:
	var replayed := 0
	for row in rows:
		var data: Dictionary = row as Dictionary
		var expected: Dictionary = data.get("expected", {})
		var raw := int(data.get("damage", 0))
		if raw <= 0:
			continue
		var school: Variant = data.get("resolved_school")
		if school != null and String(school) not in SCHOOLS:
			continue
		replayed += 1
		var label := String(data["name"])
		var world := _world()
		var attacker: HeroState = _hero_of_team(world, World.BLUE)
		var definition = TROLL.duplicate()
		definition.armor = float(data.get("armor", 0.0))
		definition.magic_resist = float(data.get("magic_resist", 0.0))
		var victim: UnitState = world.spawn_unit(definition, World.RED, 1)
		if victim == null or attacker == null:
			check.call(false, "%s: the minion victim spawns" % label)
			continue
		victim.armor_shred_amount = float(data.get("armor_shred", 0.0))
		victim.dmg_amp_timer = int(data.get("dmg_amp_timer", 0))
		victim.dmg_amp_amount = float(data.get("dmg_amp_amount", 0.0))
		var hp_before: float = victim.hp
		# The source resolver returns None for school-free hits; the native entry
		# point carries "neutral" for those.
		var entry_school := String(school) if school != null else "neutral"
		var landed: bool = world._deliver_hit(
			attacker.id,
			attacker.team,
			victim,
			raw,
			entry_school,
			attacker.position,
			String(data.get("damage_type", "normal"))
		)
		var loss := int(hp_before - victim.hp)
		var want := int(expected["hp_loss"])
		check.call(
			loss == want, "%s: the source minion ladder deals %d (got %d)" % [label, want, loss]
		)
		check.call(landed == (want > 0), "%s: the landed flag follows the ladder" % label)
		check.call(
			attacker.damage_dealt == want,
			"%s: the credited damage is the post-mitigation hit" % label
		)
		if int(data["native_old"]["hp_loss"]) != want:
			check.call(
				loss != int(data["native_old"]["hp_loss"]),
				"%s: the ladder no longer equals the pre-9n column" % label
			)
	check.call(replayed >= 8, "at least eight fixture rows replay through the production path")


func _boss_order(check: Callable) -> void:
	# `BaseBoss.take_damage` is a separate port, so boss targets must keep the
	# pre-9n order even though every other unit runs the minion ladder.
	var boss := BossState.new()
	var definition = TROLL.duplicate()
	definition.armor = TROLL_ARMOR
	definition.magic_resist = 0.0
	boss.boss_type = "probe"
	boss.definition = definition
	boss.is_hero = false
	boss.dmg_amp_timer = 240
	boss.dmg_amp_amount = 0.3
	check.call(
		DamageRules.item_aware_amount(boss, 200, "physical") == BOSS_ORDER_HIT,
		"a boss target keeps the school-first order"
	)
	check.call(
		DamageRules.minion_amount(boss, 200, "physical") == MINION_LADDER_HIT,
		"the minion ladder would have dealt the diverging amount"
	)
	check.call(
		DamageRules.item_aware_amount(boss, 200, "neutral") == 200,
		"a school-free boss hit still lands raw"
	)
	# A live minion without amp/shred keeps the two control values of 9l.
	var world := _world()
	var undead = world.spawn_unit(UNDEAD, World.RED, 1)
	check.call(undead != null, "the undead control unit spawns")
	if undead != null:
		check.call(
			DamageRules.item_aware_amount(undead, 200, "magic") == 170,
			"a minion magic hit still uses magic resist"
		)
		check.call(
			DamageRules.item_aware_amount(undead, 200, "neutral") == 200,
			"a minion neutral hit without amp stays raw"
		)


func _world() -> World:
	var world := World.new()
	world.setup_arena()
	return world


func _hero_of_team(world: World, team: int) -> HeroState:
	for unit in world.units:
		var hero := unit as HeroState
		if hero != null and hero.is_hero and hero.team == team and hero.alive:
			return hero
	return null

class_name Localization
extends RefCounted

## Native port of localization.py. The JSON contract is generated by
## tools/prepare_godot_localization.py; runtime never imports Python.
const DEFAULT_PATH := "res://data/localization.json"
var languages: Array = []
var language_labels: Dictionary = {}
var default_language := "id"
var texts: Dictionary = {}
var key_order: Array = []
var key_count := 0
var load_error := ""
var _language := "id"


func _init(path := DEFAULT_PATH) -> void:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		load_error = "Cannot open %s" % path
		return
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	if not parsed is Dictionary:
		load_error = "Invalid localization JSON"
		return
	if int(parsed.get("schema", 0)) != 1 or str(parsed.get("source", "")) != "localization.py":
		load_error = "Unsupported localization contract"
		return
	languages = parsed.get("languages", [])
	language_labels = parsed.get("language_labels", {})
	default_language = str(parsed.get("default_language", "id"))
	texts = parsed.get("texts", {})
	key_order = parsed.get("key_order", [])
	key_count = int(parsed.get("key_count", 0))
	if languages.size() < 1 or not texts.has(default_language):
		load_error = "Localization contract missing default language"
		return
	if key_count != key_order.size() or key_count <= 0:
		load_error = "Localization key count mismatch"
		return
	for language: String in languages:
		if not texts.has(language) or not language_labels.has(language):
			load_error = "Localization language table/label missing: %s" % language
			return
	_language = default_language


func valid() -> bool:
	return load_error.is_empty()


func set_language(language: String) -> String:
	_language = language if languages.has(language) else default_language
	return _language


func get_language() -> String:
	return _language


func get_language_label(language := "") -> String:
	var key := language if not language.is_empty() else _language
	return str(language_labels.get(key, language_labels.get(default_language, default_language)))


func tr_text(key: String, args: Dictionary = {}) -> String:
	return tr_for(key, _language, args)


func tr_for(key: String, language: String, args: Dictionary = {}) -> String:
	if not valid():
		return key
	var active := language if texts.has(language) else default_language
	var table: Dictionary = texts.get(active, {})
	var fallback: Dictionary = texts.get(default_language, {})
	var template := str(table.get(key, fallback.get(key, key)))
	return format_template(template, args)


static func format_template(template: String, args: Dictionary) -> String:
	# Python str.format(**values) subset used by localization.py: plain named
	# placeholders only. If any placeholder is missing or malformed, Python
	# raises KeyError/ValueError and tr() returns the untouched template.
	var out := ""
	var index := 0
	var length := template.length()
	while index < length:
		var ch := template[index]
		if ch == "{":
			if index + 1 < length and template[index + 1] == "{":
				out += "{"
				index += 2
				continue
			var end := template.find("}", index + 1)
			if end < 0:
				return template
			var name := template.substr(index + 1, end - index - 1)
			if not _is_identifier(name) or not args.has(name):
				return template
			out += str(args[name])
			index = end + 1
		elif ch == "}":
			if index + 1 < length and template[index + 1] == "}":
				out += "}"
				index += 2
				continue
			return template
		else:
			out += ch
			index += 1
	return out


static func _is_identifier(value: String) -> bool:
	if value.is_empty():
		return false
	for index in range(value.length()):
		var ch := value[index]
		var letter := (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
		var digit := ch >= "0" and ch <= "9"
		if index == 0:
			if not letter:
				return false
		elif not letter and not digit:
			return false
	return true

<?xml version="1.0" encoding="utf-8"?>
<!--
  Aturan Android Auto Backup untuk perangkat Android <= 11
  (dirujuk dari AndroidManifest lewat android:fullBackupContent,
  di-set otomatis oleh opsi `android.backup_rules` di buildozer.spec).

  HANYA folder saves/ (di dalam getFilesDir) yang di-backup ke
  Google Drive. Begitu ada <include>, semua yang lain otomatis
  TIDAK ikut - penting, karena files/app berisi seluruh kode+aset
  game hasil ekstrak p4a; kalau ikut, backup melebihi kuota 25 MB
  dan GAGAL total.
-->
<full-backup-content>
    <include domain="file" path="saves/" />
</full-backup-content>
